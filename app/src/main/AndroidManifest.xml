<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      No FOREGROUND_SERVICE: the app declares no foreground service. The accessibility service is
      bound by the system with BIND_FOREGROUND_SERVICE, which is what keeps the process alive, and
      notify.SessionNotifications posts the session notification through NotificationManager. See the
      class KDoc there for why a specialUse foreground service was rejected.
    -->
    <!--
      SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM: Google Play allows USE_EXACT_ALARM only to apps whose
      core function is an alarm clock or a calendar, and rejected a release that declared it. This one
      is a switch the user grants (Alarms & reminders, off by default on Android 14+); without it
      SessionEngine.scheduleAlarm falls back to an inexact alarm and says so.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      Requested at runtime only when capture verification or the interval after the photo is finished
      is switched on. READ_MEDIA_IMAGES exists from Android 13; below it the same MediaStore read is
      READ_EXTERNAL_STORAGE, capped so it is never requested (or shown) where the media permission
      replaces it. Permissions.photos picks the one.

      READ_MEDIA_VISUAL_USER_SELECTED is what "Select photos" grants on Android 14+. Undeclared, the
      platform answered that choice in compatibility mode: READ_MEDIA_IMAGES reported *granted*
      (one-time, until the app went to the background) while MediaStore returned only the picked
      photos, so the app said "photos permission granted" and could not see a single new frame.
      Declared, "Select photos" leaves READ_MEDIA_IMAGES denied and is recognised as partial access.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      The only two network permissions, and the only reason either is here: fetching terrain
      elevation tiles for the real-horizon layer in the AR views.

      `INTERNET` is a `normal` permission - granted at install, no runtime API, and on stock Android
      the user cannot revoke it. So the guarantee this app used to get from the operating system is
      gone, and what replaces it is checkable in the source instead:

        * every socket is opened in data/horizon/DemTileDownloader.kt, and NetworkIsolationTest
          fails the build if a second place ever appears;
        * nothing is sent but a 1-degree tile name in a URL path - no identifiers, no fine
          coordinates, no request body;
        * DemTileDownloader consults the stored consent on every call, so revoking it in Settings
          takes effect immediately;
        * deleting the INTERNET line below is a supported way to build from source without any
          network at all. NetworkAvailability.hasInternetPermission() notices at runtime, the app
          hides the download entirely, and the hand-import path still delivers the whole feature.

      One more consumer, and it is not a socket of this app: the ARCore Geospatial API (off unless
      the user turns it on twice in Settings) is documented to require the host app to hold
      INTERNET, and the traffic is Google Play Services for AR's, not ours. It adds no permission
      and no code that opens a connection here; what it does send is spelled out in Settings and in
      the README, and ar/pose/ArCoreSessionController is the only thing that can start it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Which other apps this one can see. Not QUERY_ALL_PACKAGES: the list of everything installed says
      which bank, which clinic and which dating app a person uses, and the app only ever needs the ones
      it can bring to the front. The target picker lists launchable apps and marks the cameras
      (ui/MainViewModel.loadInstalledApps); a session and the calibration launch the picked one and read
      its label, which a launchable app is visible for. ARCore is looked up by name
      (ar/pose/ArCorePresence). An accessibility event names the foreground package without any of this.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <package android:name="com.google.ar.core" />
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caelis">

        <!--
          ARCore is optional: the app is fully usable on the phone's own sensors, and the library is
          inert until the user turns it on in Settings. "required" would hide the app on Google Play
          from every device without ARCore and make Play install Google Play Services for AR
          alongside it, before anyone has agreed to anything. Starting it, and even asking whether it
          is present, is gated on consent by ar/pose/ArCoreSessionController; NetworkIsolationTest
          pins this value.
        -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!--
          Geospatial API key, injected at build time from local.properties (geospatial.api.key) or the
          CAELIS_GEOSPATIAL_API_KEY environment variable. It is never written here: the test suite
          fails if a literal key appears in the sources. Empty in a build without one, and then the
          Geospatial switch is not offered and the API is never requested.
        -->
        <meta-data
            android:name="com.google.android.ar.API_KEY"
            android:value="${geospatialApiKey}" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              A place handed over by a map app: shared text (Mapy.com, Google Maps, a message with
              coordinates) or a geo: link. Only parsed (domain/location/IncomingPlaceParser), never
              followed, and it does nothing until the user saves it or downloads its terrain.
            -->
            <intent-filter android:label="@string/incoming_place_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/incoming_place_share_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <!--
          There is no calibration Activity: the capture surface is the overlay window below, started
          straight from the (foreground) Compose screen through overlay.CalibrationOverlay.start.
        -->

        <!--
          Owns the calibration capture window (TYPE_APPLICATION_OVERLAY) while the user designates the
          shutter in the real camera app. Plain started service on purpose: it lives for the seconds
          calibration takes, and a process holding a visible overlay window is not torn down under it.
        -->
        <service
            android:name=".overlay.CalibrationOverlayService"
            android:exported="false" />

        <!-- Records a camera mode over the camera app, like calibration; not exported. -->
        <service
            android:name=".overlay.ModeRecordingService"
            android:exported="false" />

        <service
            android:name=".service.ShutterAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".service.SessionAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
